{
  "name": "leaklens",
  "version": "1.0.0",
  "description": "Local screenshot evidence analysis and permanent redaction",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "predev": "node scripts/prepare-assets.mjs",
    "build": "next build --webpack",
    "prebuild": "node scripts/prepare-assets.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "prepare": "node scripts/prepare-assets.mjs",
    "gemini:check": "node scripts/check-gemini.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
